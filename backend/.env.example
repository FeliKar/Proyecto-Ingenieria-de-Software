# Fuente de datos de trámites.
#
# Sin PRAXSUITE_API_KEY ni PRAXSUITE_API_KEY_FILE, el backend usa los JSON de
# src/data (y los tests siempre lo hacen).

# Server API key (sk_live_...). No la subas al repositorio.
# PRAXSUITE_API_KEY=sk_live_...

# Alternativa: archivo que contiene la key (recomendado para desarrollo local).
PRAXSUITE_API_KEY_FILE=~/.secrets/praxsuite-munichatia.key

# Base del gateway. Por defecto apunta al workspace MuniChatIA.
# PRAXSUITE_GATEWAY_URL=https://gateway.praxsuite.com/ce9ad0db-ae38-45b8-9f83-17ada629fad9

# Tablas del DataEngine (los valores por defecto ya son los de MuniChatIA).
# PRAXSUITE_TABLE_TRAMITES=6034e65d-c034-4748-adac-70cbd870196b
# PRAXSUITE_TABLE_CLASES=e3b6afa5-0f4c-42f4-a38f-067e9ebc93e2
# PRAXSUITE_TABLE_ALIAS=5ac825de-0095-4c31-8698-cff7d29a54df
# PRAXSUITE_TABLE_TRAMITE_CLASE=d67f236b-7c97-46bb-aada-3c1affaa5d5d
# PRAXSUITE_TABLE_REQUISITOS=70bde8de-82f3-4825-80b2-dae337741d90
# PRAXSUITE_TABLE_PASOS=53e3a700-e1df-4072-bc4e-938e1795beb7

# Caché en memoria de la respuesta del gateway (milisegundos).
# PRAXSUITE_CACHE_TTL_MS=300000

# 1 = forzar el uso de los JSON locales ignorando cualquier credencial.
# PRAXSUITE_DISABLED=1
