@startuml
title Figura 4.2 · Clases de diseño del alcance (SRP: una responsabilidad por caja)
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
skinparam minClassWidth 240
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EEF3FA
  BorderColor #1F3A5F
  ArrowColor #1F3A5F
  HeaderBackgroundColor #1F3A5F
  AttributeFontColor #1F3A5F
  AttributeFontSize 11
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #FFFFFF
  FontColor #555555
  FontSize 11
}

' Fila 1
class "<color:#FFFFFF><b>TramitesRoutes</b></color>" as TramitesRoutes {
  {field} + POST /api/tramites/consultar
  {field} recibe pregunta o tramiteId y responde
}
class "<color:#FFFFFF><b>TramiteMatcher</b></color>" as TramiteMatcher {
  {field} + matchTramiteDetalle(pregunta, fichas)
  {field} decide ficha, ambiguo o sin match
}
class "<color:#FFFFFF><b>ResultadoMatch</b></color>" as ResultadoMatch {
  {field} ficha | null, motivo, clase?, opciones?
  {field} resultado del matching
}

' Fila 2
class "<color:#FFFFFF><b>Abstencion</b></color>" as Abstencion {
  {field} ABSTENCION_MENSAJE · CANAL_DERIVACION
  {field} textos fijos, no usan la pregunta
}
class "<color:#FFFFFF><b>FichaTramite</b></color>" as FichaTramite {
  {field} id, tramite, requisitos, pasos,
  {field} vigencia, alias, enlace_oficial, clase?
}
class "<color:#FFFFFF><b>OpcionTramite</b></color>" as OpcionTramite {
  {field} id, tramite
  {field} opción para desambiguar
}

TramitesRoutes -right- TramiteMatcher
TramiteMatcher -right- ResultadoMatch
TramitesRoutes -down- Abstencion
TramiteMatcher -down- FichaTramite
ResultadoMatch -down- OpcionTramite
Abstencion -[hidden]right- FichaTramite
FichaTramite -[hidden]right- OpcionTramite

legend bottom left
  Coherencia: TramitesRoutes → routes/tramites.routes.ts · TramiteMatcher, ResultadoMatch, OpcionTramite → services/tramiteMatcher.ts · FichaTramite → types/ficha.ts · Abstencion → constants/abstention.ts
  Deuda S1: TramitesRoutes también carga fichas.json y arma la respuesta (no hay capa de servicio, T4). Matching por palabras clave, sin LLM (US-10 en S2+).
endlegend
@enduml